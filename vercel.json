{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "crons": [
    { "path": "/api/cron/deadline-reminders", "schedule": "0 3 * * *" },
    { "path": "/api/cron/match-digest", "schedule": "15 3 * * *" },
    { "path": "/api/cron/catalogue-health", "schedule": "0 4 * * *" },
    { "path": "/api/cron/followups", "schedule": "0 5 * * 1" }
  ]
}
