VITE_API_BASE=
# Supabase client config — use the ANON / publishable key only.
# The service-role / secret key is backend-only and must never appear here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_publishable_key
# VAPID public key for browser Web Push (safe to expose; paired private key is backend-only).
VITE_VAPID_PUBLIC_KEY=
