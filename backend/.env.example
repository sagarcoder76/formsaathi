TINYFISH_API_KEY=your_key_here
FRONTEND_ORIGIN=http://localhost:5173
# Supabase service-role integration (server-side only — never expose to the browser).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Scheduled notification jobs: Vercel cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=choose_a_long_random_string
# Web Push (VAPID). Private key stays server-side; the matching public key ships to the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Resend email (optional — email alerts stay dormant until a key is provided).
RESEND_API_KEY=
RESEND_FROM=FormSaathi <onboarding@resend.dev>
